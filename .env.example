# ---- Portal ----
# REQUIRED: the password guests type in. The container won't start without it.
PORTAL_PASSWORD=
# Shown as the browser tab title, in the welcome heading and the footer
PORTAL_TITLE=Guest Wi-Fi
# Animated neon logo lines. Blank = first and second word of PORTAL_TITLE
LOGO_TOP=
LOGO_BOTTOM=
# Footer text. Blank = PORTAL_TITLE
FOOTER_TEXT=
# How long a guest stays authorised, in minutes (1440 = 24 hours)
GUEST_MINUTES=1440
# Optional: always send guests here after login (otherwise they go to the page they originally asked for)
SUCCESS_URL=

# ---- UniFi controller ----
# UniFi OS console (UDM / UDR / UCG / Cloud Key Gen2+ / UniFi OS Server): https://192.168.1.1
# Classic self-hosted Network Application:                               https://10.0.0.5:8443
# Leave blank to run in DEMO MODE (password is checked but nobody is let online).
UNIFI_URL=https://192.168.1.1

# Option A (recommended, UniFi Network 9.3+): an API key.
# Create one in UniFi Network: Settings > Control Plane > Integrations.
UNIFI_API_KEY=
# Optional site UUID. Blank = looked up automatically.
UNIFI_SITE_ID=

# Option B (older controllers): a LOCAL admin account (not a ui.com cloud account with 2FA).
# Only used when UNIFI_API_KEY is blank.
UNIFI_USERNAME=
UNIFI_PASSWORD=
# Site name (the bit in the URL, usually "default"). Blank = use the site UniFi puts in the redirect.
UNIFI_SITE=
# auto | unifios | classic
UNIFI_TYPE=auto
# Controllers use self-signed certificates, so verification is off by default
UNIFI_VERIFY_TLS=false

# ---- Brute-force protection: max wrong passwords per device IP per window ----
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SEC=300

# ---- Optional: video shown when someone types the wrong password ----
# Path INSIDE the container. Map your own file in with a volume (see docker-compose.yml).
# .mp4 (H.264/AAC) works on every phone; .webm and .mov are also accepted.
WRONG_PASSWORD_VIDEO=

# ---- Optional: your own music files ----
# Folder INSIDE the container. Name files after the theme: australiaday.mp3, christmas.mp3, halloween.m4a ...
# default.mp3 replaces the everyday lo-fi track. Themes without a file keep the built-in music.
MUSIC_DIR=
